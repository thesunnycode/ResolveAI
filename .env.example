# ─────────────────────────────────────────────────────────────────────────────
# ResolveAI — environment template.  Copy to .env and fill in.
# NAMES ONLY in this file. Never commit a real value.
# ─────────────────────────────────────────────────────────────────────────────

SPRING_PROFILES_ACTIVE=local

# ── Datastores (defaults match docker-compose.yml) ──────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:55432/resolveai
DATABASE_USERNAME=resolveai
DATABASE_PASSWORD=
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────────────────
# Must be at least 256 bits. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── LLM providers ───────────────────────────────────────────────────────────
# Primary and fallback MUST be different vendors — two keys from one provider
# fail together, which defeats the failover path (doc 11 Task 16).
LLM_PRIMARY_PROVIDER=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
EMBEDDING_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Object storage ──────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=resolveai-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Security ────────────────────────────────────────────────────────────────
# AES-GCM key for the PII placeholder map. openssl rand -base64 32
PII_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Worker tuning (doc 03 §2 — polling dominates DB load, tune deliberately) ─
WORKER_POOL_SIZE=8
WORKER_POLL_INTERVAL_MS=1000
SLA_POLLER_BATCH_SIZE=200

# ── Correlation gate (doc 12 Task 7 — tuned in Task 11, do not guess) ───────
CORRELATION_WINDOW_MINUTES=30
CORRELATION_MIN_CLUSTER_SIZE=5
CORRELATION_RATE_MULTIPLIER=3.0

# ── Drafting ────────────────────────────────────────────────────────────────
DRAFT_COVERAGE_THRESHOLD=0.8

# ── Cost control ────────────────────────────────────────────────────────────
MONTHLY_TOKEN_BUDGET_MICROS=5000000
